			)
		)
		(uuid "b1387a4a-7fb2-4114-ba62-eca9ea7e765a")
	)
	(text_box "I\n= 4.2V / 33Ω\n≒ 0.127A\n\nP\n= 0.127A * 0.127A * 33Ω\n≒ 0.532W"
		(exclude_from_sim no)
		(at 166.37 103.1639 0)
		(size 27.94 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
