				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1b637827-f70d-4dcd-98a8-330bb63b2d15")
	)
	(text_box "PORTD：D0~7\nPORTB：D8~13\nPORTC：A0~5"
		(exclude_from_sim no)
		(at 96.52 25.4 0)
		(size 16.51 8.0376)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
